# Non-sensitive adapter configuration. Credentials are Firebase secrets and
# must never be written to this file.
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_SERVICE_ACCOUNT=insightpad-ifood-adapter@PROJECT_ID.iam.gserviceaccount.com
# Enable after registering the production web app with Firebase App Check.
ENFORCE_APP_CHECK=false
